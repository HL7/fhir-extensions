  </contact>
  <description value="This extension is for use when a value set is to be used to render a list of code choices for human selection (typically in Questionnaires). It allows specifying a prefix to put in front of the display name of the code display value. For example &quot;a)&quot;, or &quot;iii.&quot; or &quot;1]&quot;. This only works if the value set is defined extensionally (i.e. enumerating the codes). If defining an intensional value set with the definition &quot;all codes from code system [some code system]&quot;, then use the [codesystem-label](StructureDefinition-codesystem-label.html) extension instead.&#xA;&#xA;Prefixes are particularly relevant if there are textual instructions that accompany the question. E.g. 'Do not select more than one of options a, b, or c' on a multi-select question."/>
  <fhirVersion value="5.0.0"/>
  <mapping>
    <identity value="rim"/>
    <uri value="http://hl7.org/v3"/>
    <name value="RIM Mapping"/>
  </mapping>
  <kind value="complex-type"/>
  <abstract value="false"/>
  <context>
    <type value="element"/>
    <expression value="ValueSet.compose.include.concept"/>
  </context>
  <context>
    <type value="element"/>
    <expression value="ValueSet.expansion.contains"/>
  </context>
  <type value="Extension"/>
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/Extension"/>
  <derivation value="constraint"/>
  <differential>
    <element id="Extension">
      <path value="Extension"/>
      <short value="E.g. &quot;(a)&quot;, &quot;1.&quot;, etc."/>
      <definition value="The label to list in front of a code when presenting a list of possible values in a questionnaire-like fashion."/>
      <comment value="For questionnaires, see additional guidance and examples in the [SDC implementation guide](http://hl7.org/fhir/uv/sdc/2025Jan/rendering.html#valueset-label)."/>
      <min value="0"/>
      <max value="1"/>
      <isModifier value="false"/>
    </element>
    <element id="Extension.extension">
      <path value="Extension.extension"/>
      <max value="0"/>
    </element>
    <element id="Extension.url">
      <path value="Extension.url"/>
      <fixedUri value="http://hl7.org/fhir/StructureDefinition/valueset-label"/>
    </element>
    <element id="Extension.value[x]">
      <path value="Extension.value[x]"/>
      <min value="1"/>
      <type>
        <code value="string"/>
      </type>
    </element>
  </differential>
</StructureDefinition>